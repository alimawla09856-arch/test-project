# =============================================================================
# AS Design Studio — Automation Suite · environment variables
# Copy to .env.local (development) or set in your host (Vercel / Docker).
# Every integration is optional: with nothing set, the app runs locally with a
# JSON file store, the rule-based estimator and a development admin login.
# =============================================================================

# --- Public URLs -------------------------------------------------------------
# Where this platform is served (used in emails, PDFs, share links, n8n payloads)
NEXT_PUBLIC_APP_URL=https://automation.asdesignlb.com
# The studio's main site (header link, "back to site" buttons)
NEXT_PUBLIC_SITE_URL=https://asdesignlb.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@asdesignlb.com
# Optional: Calendly / Cal.com link offered after submission and acceptance
NEXT_PUBLIC_BOOKING_URL=
# Optional footer / PDF line, e.g. "Beirut · Worldwide"
NEXT_PUBLIC_STUDIO_LOCATION=
NEXT_PUBLIC_CURRENCY=USD

# --- Admin access ------------------------------------------------------------
# 32+ random characters:  openssl rand -base64 48
SESSION_SECRET=
ADMIN_EMAIL=you@asdesignlb.com
# Generate with:  npm run admin:hash -- "your long password"
ADMIN_PASSWORD_HASH=
# Optional extra admins: comma-separated email:hash pairs
ADMIN_USERS=

# --- Data store --------------------------------------------------------------
# supabase | local   (auto: supabase when both keys below are set)
DATA_STORE=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only! Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# JSON file store location when DATA_STORE=local
LOCAL_DATA_DIR=.data

# --- AI scope & budget analysis ---------------------------------------------
# anthropic | openai | heuristic   (auto: anthropic when ANTHROPIC_API_KEY is set)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
AI_EFFORT=high
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Fall back to the rule-based estimator if the AI call fails (recommended)
AI_FALLBACK_TO_HEURISTIC=true
# n8n | app  — who runs the AI analysis (auto: n8n when lead-intake + analysis webhooks are set)
ANALYSIS_RUNNER=

# --- n8n ---------------------------------------------------------------------
# Base of your n8n production webhook URLs; the app appends:
#   /asd-lead-intake  /asd-ai-analysis  /asd-proposal-dispatch  /asd-crm-sync
N8N_WEBHOOK_BASE_URL=https://n8n.asdesignlb.com/webhook
# app → n8n: sent as "Authorization: Bearer <secret>" (+ HMAC X-ASD-Signature)
N8N_WEBHOOK_SECRET=
# n8n → app: n8n sends "Authorization: Bearer <secret>" to /api/v1/*
N8N_CALLBACK_SECRET=
# Optional per-workflow overrides (full URLs)
N8N_WEBHOOK_LEAD_INTAKE=
N8N_WEBHOOK_ANALYSIS=
N8N_WEBHOOK_DISPATCH=
N8N_WEBHOOK_CRM_SYNC=
N8N_CRM_SYNC_ENABLED=true

# --- Security & embedding ------------------------------------------------------
# Sites allowed to iframe /embed (CSP frame-ancestors), space or comma separated
EMBED_ALLOWED_ORIGINS=https://asdesignlb.com https://www.asdesignlb.com
# Origins allowed to POST /api/v1/onboard directly from the browser (custom forms)
ALLOWED_ORIGINS=https://asdesignlb.com,https://www.asdesignlb.com
# Shared rate limiting across instances (recommended on serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashed client IPs (defaults to SESSION_SECRET)
IP_HASH_SALT=
# Minimum seconds a human needs to complete the builder (spam heuristic)
ONBOARD_MIN_FILL_SECONDS=4
